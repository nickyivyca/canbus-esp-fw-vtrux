build/
# Measurement/variant builds get their own directory: ESP-IDF names the
# image from the commit, so two configurations of one commit would otherwise
# produce the same filename in the same place.
build-*/
esp_idf_components/
# Prerequisites
*.d

# Object files
*.o
*.ko
*.obj
*.elf

# Linker output
*.ilk
*.map
*.exp

# Precompiled Headers
*.gch
*.pch

# Libraries
*.lib
*.a
*.la
*.lo

# Shared objects (inc. Windows DLLs)
*.dll
*.so
*.so.*
*.dylib

# Executables
*.exe
*.out
*.app
*.i*86
*.x86_64
*.hex

# Debug files
*.dSYM/
*.su
*.idb
*.pdb

# Kernel Module Compile Results
*.mod*
*.cmd
.tmp_versions/
modules.order
Module.symvers
Mkfile.old
dkms.conf

# docs
gen-inhibit/firmware/docs/.nuxt
gen-inhibit/firmware/docs/node_modules

#Vehicle Profiles
gen-inhibit/firmware/.vehicle_profiles/node_modules/
.vscode/
managed_components/

# Rust (gen-inhibit/firmware/tools/wican-log-viewer)
gen-inhibit/firmware/tools/wican-log-viewer/target/
**/target/
*.rs.bk
gen-inhibit/firmware/tools/wican-log-viewer/.cargo/

# Rust coverage / profiling
**/llvm-profdata
**/llvm-profraw
*.profraw
*.profdata

# OS-specific junk inside Rust tool dir
gen-inhibit/firmware/tools/wican-log-viewer/*.dSYM/
gen-inhibit/firmware/tools/wican-log-viewer/*.pdb
gen-inhibit/firmware/tools/wican-log-viewer/*.dll
gen-inhibit/firmware/tools/wican-log-viewer/*.exe


# Fuzz inputs are regenerated from a seed; only a kept failure is worth saving
# by hand, and it should be copied somewhere deliberate if so.
gen-inhibit/test/gen_inhibit_host/artifacts/fuzz-*.scn
__pycache__/
*.pyc

# Agent sessions: per-worktree files, never committed
local-paths.md
scratch/
.claude/memory/
