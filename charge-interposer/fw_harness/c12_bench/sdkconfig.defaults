CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
# The X2's USB socket is the S3's own USB Serial/JTAG; the request lines
# and the transcript travel over it.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
# 1 ms ticks so advanceUs() yields in small steps.
CONFIG_FREERTOS_HZ=1000
# Nothing but the protocol on the console: IDF's own log lines would sit
# between a request and its reply.
CONFIG_LOG_DEFAULT_LEVEL_WARN=y
CONFIG_BOOTLOADER_LOG_LEVEL_WARN=y
# The board waits on the host indefinitely between commands.
CONFIG_ESP_TASK_WDT_EN=n
