{
  "target": "esp32s3",
  "flash_size": "8MB",
  "partition_table": "baseline-partition-table.bin",
  "required": [
    {"setting": "the console",
     "choice": ["CONFIG_ESP_CONSOLE_UART_DEFAULT", "CONFIG_ESP_CONSOLE_USB_CDC",
                "CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG", "CONFIG_ESP_CONSOLE_UART_CUSTOM",
                "CONFIG_ESP_CONSOLE_NONE"]},
    {"setting": "the secondary console",
     "choice": ["CONFIG_ESP_CONSOLE_SECONDARY_NONE", "CONFIG_ESP_CONSOLE_SECONDARY_USB_SERIAL_JTAG"]},
    {"setting": "the bootloader watchdog in user code", "option": "CONFIG_BOOTLOADER_WDT_DISABLE_IN_USER_CODE"},
    {"setting": "the task watchdog's panic", "option": "CONFIG_ESP_TASK_WDT_PANIC"},
    {"setting": "Bluetooth on or off", "option": "CONFIG_BT_ENABLED"},
    {"setting": "PSRAM on or off", "option": "CONFIG_SPIRAM"},
    {"setting": "where a core dump goes",
     "choice": ["CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH", "CONFIG_ESP_COREDUMP_ENABLE_TO_UART",
                "CONFIG_ESP_COREDUMP_ENABLE_TO_NONE"]}
  ],
  "hardware_name": "ESP32-CAN-X2"
}
